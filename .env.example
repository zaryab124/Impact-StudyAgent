# ==============================================================================
# AI Live Paper Generator - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Live Paper Generator"

# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/live_paper_gen?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/live_paper_gen?schema=public"

# Authentication & Session Security (NextAuth / JWT)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-32-character-cryptographically-secure-secret-here"
SESSION_MAX_AGE_SECONDS=86400

# AI Provider Configuration (Server-Side ONLY - NEVER expose to browser)
# Primary Default Provider: gemini | openai | anthropic
AI_DEFAULT_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Optional Alternative Providers (Architecturally supported for Phase 2+)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Security & Rate Limiting (Phase 10 Tiered Rate Limits)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000

# Document Storage Vault (Phase 10 Storage Abstraction)
STORAGE_PROVIDER="local" # local | s3
STORAGE_LOCAL_PATH="./storage-vault"
MAX_FILE_SIZE_BYTES=52428800 # 50MB

# S3 Compatible Storage (MinIO, Cloudflare R2, AWS S3)
S3_ENDPOINT=""
S3_BUCKET="educational-curriculum-vault"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Knowledge Ingestion & NotebookLM Connector (Phase 10)
NOTEBOOKLM_WORKSPACE_PATH="./data/curriculum/notebooks"
NOTEBOOKLM_ENDPOINT=""
NOTEBOOKLM_API_KEY=""

# Multi-LLM Consensus Engine (Phase 10)
AI_CONSENSUS_THRESHOLD=0.80 # 80% agreement required before auto-acceptance
AI_ALLOW_DETERMINISTIC_FALLBACK=true

# Background Jobs Engine (Phase 10)
JOB_CONCURRENCY_LIMIT=5
JOB_MAX_ATTEMPTS=3
JOB_BASE_RETRY_DELAY_MS=1000

